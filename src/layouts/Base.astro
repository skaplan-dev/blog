---
import '../styles/global.css';
// Self-hosted face for the snow theme. Browsers only download it when a page renders it.
import '@fontsource-variable/hanken-grotesk';
import Index from '../components/Index.astro';
import type { Current } from '../lib/nav';
import { DEFAULT_THEME, resolveTheme, themeStyle, type Theme } from '../lib/themes';
import { SITE_NAME, DEFAULT_DESCRIPTION, DEFAULT_IMAGE, personLd, type ShareImage } from '../lib/seo';

type Props = {
  title: string;
  description?: string | undefined;
  current: Current;
  /** Defaults to the site theme; posts pass their own. */
  theme?: Theme;
  /** Path of this page's canonical URL. Defaults to the page's own path. */
  canonical?: string | undefined;
  /** Link-preview image. Defaults to the baseball card. */
  image?: ShareImage;
  /** 'article' for posts. */
  type?: 'website' | 'article';
  /** Structured data for search engines (schema.org JSON-LD). Defaults to the site's Person. */
  jsonLd?: Record<string, unknown>;
};
const {
  title,
  description = DEFAULT_DESCRIPTION,
  current,
  theme = resolveTheme(DEFAULT_THEME),
  canonical = Astro.url.pathname,
  image = DEFAULT_IMAGE,
  type = 'website',
  jsonLd = personLd(Astro.site),
} = Astro.props;
const pageTitle = title.startsWith(SITE_NAME) ? title : `${title} · ${SITE_NAME}`;
const url = new URL(canonical, Astro.site);
const imageUrl = new URL(image.src, Astro.site);
---

<!doctype html>
<html lang="en" style={themeStyle(theme)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={url} />
    <meta name="theme-color" content={theme.paper} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap.xml" />

    <!-- Link previews (Open Graph, read by iMessage, Slack, LinkedIn, Bluesky, X…) -->
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content={String(image.width)} />
    <meta property="og:image:height" content={String(image.height)} />
    <meta property="og:image:alt" content={image.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={image.alt} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <slot name="head" />
  </head>
  <body>
    <div class="shell">
      <Index current={current} />
      <main>
        <slot />
      </main>
    </div>
  </body>
</html>
