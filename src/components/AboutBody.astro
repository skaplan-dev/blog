---
/* The About page: a vintage baseball card, front and back side by side.
   The front borrows the mid-'70s layout (two-tone border, drop-shadowed word on top, rounded
   photo frame, a baseball in the corner); none of a real set's marks. Data lives in src/lib/card.ts. */
import { card, seasons } from '../lib/card';
// Phosphor's tram (duotone), inlined so it takes the card's ink via currentColor.
import tram from '@phosphor-icons/core/assets/duotone/tram-duotone.svg?raw';
// Tabler's baseball: diagonal seams with stitches, reads as a ball even small.
import baseballFront from '@tabler/icons/outline/ball-baseball.svg?raw';
---

<div class="cards">
  <!-- The front follows a mid-'70s card: two-tone border, drop-shadowed word on top, rounded
       photo frame, a baseball in the corner. -->
  <section class="card front" aria-label="Card front">
    <p class="team" aria-hidden="true">{card.team}</p>
    <div class="frame">
      <div class="photo">
        {card.photo ? <img src={card.photo} alt={card.name} /> : <span class="todo">Photo</span>}
      </div>
    </div>
    <h2 class="name">{card.name}</h2>
    <div class="ball" aria-hidden="true" set:html={baseballFront} />
  </section>

  <!-- The back: one green ink on cardboard, thin rules instead of filled blocks. Name and number
       up top, vitals, the career record, a short bio and a fun fact, then the printer's line. -->
  <section class="card back" aria-label="Card back">
    <header class="bhead">
      <span class="num">{card.no}</span>
      <div>
        <h3 class="nm">{card.name}</h3>
        <p class="sub">{card.pos} · {card.home}</p>
      </div>
      <span class="icon tram-icon" aria-hidden="true" set:html={tram} />
    </header>

    <dl class="vitals">
      <div><dt>Bats</dt><dd>{card.bats}</dd></div>
      <div><dt>Throws</dt><dd>{card.throws}</dd></div>
      <div><dt>Fav team</dt><dd>{card.favTeam}</dd></div>
    </dl>

    <table class="record">
      <caption>Career record</caption>
      <thead>
        <tr><th>Year</th><th>Club</th><th>Pos</th></tr>
      </thead>
      <tbody>
        {
          seasons.map((s) => (
            <tr>
              <td class="yrs">{s.years}</td>
              <td>{s.href ? <a href={s.href}>{s.club}</a> : s.club}</td>
              <td>{s.pos}</td>
            </tr>
          ))
        }
      </tbody>
    </table>

    <p class="blurb">{card.blurb}</p>
    <p class="fact">
      <span class="icon ball-icon" aria-hidden="true" set:html={baseballFront} />
      {card.funFact ?? <span class="todo">one line about you</span>}
    </p>

    <p class="imprint">© 2026 sethwashere.com · Prtd in U.S.A.</p>
  </section>
</div>

<style>
  /* Only the cards are printed in color; the rest of the site stays black and white.
     Each face sets its own inks below. */
  .cards {
    --c-cream: #f7f2e4;
    --c-ink: #1b1a17;

    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr));
    gap: clamp(16px, 2.5vw, 32px);
    max-width: 860px;
    align-items: start;
  }
  /* Everything inside a card scales with the card (cqi = 1% of its width). The card's own
     border and corners can't use cqi (it would measure the page), so they're in px. */
  .card {
    container-type: inline-size;
    aspect-ratio: 5 / 7;
    border-radius: 9px;
    color: var(--c-ink);
    box-shadow:
      0 1px 2px rgb(0 0 0 / 0.18),
      0 10px 24px -10px rgb(0 0 0 / 0.35);
  }

  /* ---------- front ---------- */
  .front {
    --f-green: #3d9a5c;
    --f-yellow: #ecd54c;
    --f-red: #d3432b;

    position: relative;
    background: linear-gradient(var(--f-green) 0 58%, var(--f-yellow) 58%);
    border: 7px solid var(--c-cream);
    overflow: hidden;
  }
  .team {
    position: absolute;
    top: 2cqi;
    left: 0;
    right: 0;
    text-align: center;
    font-family: var(--font-display);
    font-size: 15cqi;
    font-weight: 900;
    line-height: 1;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--f-red);
    /* the hard black drop that '70s card lettering is printed with */
    text-shadow: 1.3cqi 1.1cqi 0 var(--c-ink);
  }
  .frame {
    position: absolute;
    top: 21cqi;
    left: 7cqi;
    right: 7cqi;
    bottom: 22cqi;
    padding: 1.6cqi;
    background: var(--c-cream);
    border-radius: 3.5cqi;
  }
  .photo {
    position: relative;
    height: 100%;
    border-radius: 2.4cqi;
    overflow: hidden;
    outline: 0.5cqi solid var(--c-ink);
    display: grid;
    place-items: center;
    background: var(--c-cream);
  }
  .photo img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* a little printed-cardboard warmth */
    filter: saturate(0.88) contrast(1.04) sepia(0.08);
  }
  .name {
    position: absolute;
    left: 8cqi;
    bottom: 6cqi;
    font-size: 8cqi;
    font-weight: 900;
    letter-spacing: 0.01em;
    line-height: 1;
    text-transform: uppercase;
    color: var(--c-ink);
  }
  /* The corner baseball: Tabler's ball-baseball, seams and stitches in red on a cream disc
     ringed in ink. Its own outline circle is hidden; the ink ring is the ball's edge. */
  .ball {
    position: absolute;
    right: 3.5cqi;
    bottom: 3cqi;
    width: 26cqi;
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle at 38% 34%, #fffdf7, #efe7d4 75%, #d9cfba);
    border: 2.6cqi solid var(--c-ink);
    color: var(--f-red);
    overflow: hidden;
    filter: drop-shadow(1.2cqi 1cqi 0 var(--c-ink));
  }
  /* The icon's ball is 18 of its 24 units; scale it so the seams run to the ink ring. */
  .ball :global(svg) {
    display: block;
    width: 133.4%;
    height: 133.4%;
    margin: -16.7%;
    stroke-width: 1.2;
  }
  .ball :global(path:nth-of-type(2)) {
    display: none;
  }

  /* ---------- back: one green ink on grey-brown cardboard ---------- */
  .back {
    --b-board: #c4b89c;
    --b-green: #2c6e4c;
    --b-red: #c4473a;

    background: var(--b-board);
    color: var(--b-green);
    border: 7px solid var(--b-board);
    outline: 2px solid var(--b-green);
    outline-offset: -12px;
    display: flex;
    flex-direction: column;
    font-family: 'Barlow Condensed', var(--font);
    font-weight: 500;
  }
  .back > * {
    margin-inline: 6cqi;
  }
  .back a {
    color: inherit;
    text-underline-offset: 0.3em;
    text-decoration-thickness: 1px;
  }
  .icon {
    display: block;
    flex: none;
  }
  .icon :global(svg) {
    display: block;
    width: 100%;
    height: auto;
  }

  /* number, name, a small tram */
  .bhead {
    display: flex;
    align-items: center;
    gap: 3.5cqi;
    margin-top: 6cqi;
    padding-bottom: 3cqi;
    border-bottom: 0.6cqi double var(--b-green);
    border-bottom-width: 1.2cqi;
  }
  .num {
    display: grid;
    place-items: center;
    width: 11cqi;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--b-red);
    color: var(--b-board);
    font-weight: 700;
    font-size: 5.4cqi;
    line-height: 1;
  }
  .bhead > div {
    flex: 1;
  }
  .nm {
    font-family: inherit;
    font-size: 9cqi;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    line-height: 1;
  }
  .sub {
    font-size: 3.8cqi;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    margin-top: 1cqi;
  }
  .tram-icon {
    width: 11cqi;
  }

  /* vitals: three small labelled cells */
  .vitals {
    display: grid;
    grid-template-columns: 1fr 1fr 2fr;
    border-bottom: 0.4cqi solid var(--b-green);
    padding-block: 2.6cqi;
  }
  dt {
    font-size: 2.8cqi;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  dd {
    font-size: 6.4cqi;
    font-weight: 700;
    line-height: 1.05;
    text-transform: uppercase;
  }

  /* career record */
  .record {
    width: auto;
    margin-top: 3.4cqi;
    font-size: 3.8cqi;
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }
  .record caption {
    text-align: left;
    font-size: 2.8cqi;
    letter-spacing: 0.1em;
    padding-bottom: 1.2cqi;
  }
  .record th,
  .record td {
    border: 0;
    padding: 0.9cqi 2cqi 0.9cqi 0;
    font-size: inherit;
    font-weight: 500;
    letter-spacing: inherit;
  }
  .record th {
    font-size: 2.8cqi;
    letter-spacing: 0.1em;
    border-bottom: 0.4cqi solid var(--b-green);
  }
  .record tbody tr + tr td {
    border-top: 0.2cqi solid rgb(44 110 76 / 0.35);
  }
  .yrs {
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }

  /* bio and fun fact, set as plain text */
  .blurb {
    margin-top: 4cqi;
    padding-top: 3cqi;
    border-top: 0.4cqi solid var(--b-green);
    font-family: var(--font);
    font-size: 3.9cqi;
    line-height: 1.4;
    color: #26402f;
  }
  .fact {
    display: flex;
    align-items: center;
    gap: 2.4cqi;
    margin-top: 3cqi;
    font-size: 4.4cqi;
    font-weight: 700;
    color: var(--b-red);
  }
  .ball-icon {
    width: 6cqi;
    color: var(--b-red);
  }
  .ball-icon :global(svg) {
    stroke-width: 1.6;
  }
  .imprint {
    margin-top: auto;
    margin-bottom: 4.6cqi;
    font-size: 2.5cqi;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
</style>
