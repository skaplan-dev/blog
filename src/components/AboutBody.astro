---
/* The About page: a vintage baseball card, front and back side by side.
   The front borrows the mid-'70s layout (two-tone border, drop-shadowed word on top, rounded
   photo frame, a baseball in the corner); none of a real set's marks. Data lives in src/lib/card.ts. */
import { card, seasons } from '../lib/card';
// Tabler's baseball: diagonal seams with stitches, reads as a ball even small.
import baseballFront from '@tabler/icons/outline/ball-baseball.svg?raw';
---

<div class="cards">
  <!-- The front follows a mid-'70s card: two-tone border, drop-shadowed word on top, rounded
       photo frame, a baseball in the corner. -->
  <section class="card front" aria-label="Card front">
    <p class="team" aria-hidden="true">{card.team}</p>
    <div class="frame">
      <div class="photo">
        {card.photo ? <img src={card.photo} alt={card.name} /> : <span class="todo">Photo</span>}
      </div>
    </div>
    <h2 class="name">{card.name}</h2>
    <div class="ball" aria-hidden="true" set:html={baseballFront} />
  </section>

  <!-- The back follows a 1975 card back: a red vitals panel, a green name band with the card
       number, the record table on bare cardboard, a red bio box, and the printer's line. -->
  <section class="card back" aria-label="Card back">
    <div class="sheet">
      <dl class="top">
        <div><dt>Bats</dt><dd>{card.bats}</dd></div>
        <div><dt>Throws</dt><dd>{card.throws}</dd></div>
        <div><dt>Loves</dt><dd>{card.loves}</dd></div>
        <div><dt>Fav team</dt><dd>{card.favTeam}</dd></div>
        <div class="span2"><dt>Home</dt><dd>{card.home}</dd></div>
      </dl>

      <div class="band">
        <span class="num">{card.no}</span>
        <span class="nm">{card.name}<span class="dot" aria-hidden="true">•</span>{card.pos}</span>
      </div>

      <div class="record">
        <h3>Major and minor league career record</h3>
        <table>
          <thead>
            <tr><th>Year</th><th>Club</th><th>Pos</th></tr>
          </thead>
          <tbody>
            {
              seasons.map((s) => (
                <tr>
                  <td class="yrs">{s.years}</td>
                  <td>{s.href ? <a href={s.href}>{s.club}</a> : s.club}</td>
                  <td>{s.pos}</td>
                </tr>
              ))
            }
          </tbody>
          <tfoot>
            <tr><td colspan="2">Career totals</td><td>{seasons.length} clubs</td></tr>
          </tfoot>
        </table>
      </div>

      <p class="blurb">{card.blurb}</p>
    </div>
    <p class="imprint">★★ © 2026 sethwashere.com, inc. prtd in u.s.a.</p>
  </section>
</div>

<style>
  /* Only the cards are printed in color; the rest of the site stays black and white.
     Each face sets its own inks below. */
  .cards {
    --c-cream: #f7f2e4;
    --c-ink: #1b1a17;

    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr));
    gap: clamp(16px, 2.5vw, 32px);
    max-width: 860px;
    align-items: start;
  }
  /* Everything inside a card scales with the card (cqi = 1% of its width). The card's own
     border and corners can't use cqi (it would measure the page), so they're in px. */
  .card {
    container-type: inline-size;
    aspect-ratio: 5 / 7;
    border-radius: 9px;
    color: var(--c-ink);
    box-shadow:
      0 1px 2px rgb(0 0 0 / 0.18),
      0 10px 24px -10px rgb(0 0 0 / 0.35);
  }

  /* ---------- front ---------- */
  .front {
    --f-green: #3d9a5c;
    --f-yellow: #ecd54c;
    --f-red: #d3432b;

    position: relative;
    background: linear-gradient(var(--f-green) 0 58%, var(--f-yellow) 58%);
    border: 7px solid var(--c-cream);
    overflow: hidden;
  }
  .team {
    position: absolute;
    top: 2cqi;
    left: 0;
    right: 0;
    text-align: center;
    font-family: var(--font-display);
    font-size: 15cqi;
    font-weight: 900;
    line-height: 1;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--f-red);
    /* the hard black drop that '70s card lettering is printed with */
    text-shadow: 1.3cqi 1.1cqi 0 var(--c-ink);
  }
  .frame {
    position: absolute;
    top: 21cqi;
    left: 7cqi;
    right: 7cqi;
    bottom: 22cqi;
    padding: 1.6cqi;
    background: var(--c-cream);
    border-radius: 3.5cqi;
  }
  .photo {
    position: relative;
    height: 100%;
    border-radius: 2.4cqi;
    overflow: hidden;
    outline: 0.5cqi solid var(--c-ink);
    display: grid;
    place-items: center;
    background: var(--c-cream);
  }
  .photo img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* a little printed-cardboard warmth */
    filter: saturate(0.88) contrast(1.04) sepia(0.08);
  }
  .name {
    position: absolute;
    left: 8cqi;
    bottom: 6cqi;
    font-size: 8cqi;
    font-weight: 900;
    letter-spacing: 0.01em;
    line-height: 1;
    text-transform: uppercase;
    color: var(--c-ink);
  }
  /* The corner baseball: Tabler's ball-baseball, seams and stitches in red on a cream disc
     ringed in ink. Its own outline circle is hidden; the ink ring is the ball's edge. */
  .ball {
    position: absolute;
    right: 3.5cqi;
    bottom: 3cqi;
    width: 26cqi;
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle at 38% 34%, #fffdf7, #efe7d4 75%, #d9cfba);
    border: 2.6cqi solid var(--c-ink);
    color: var(--f-red);
    overflow: hidden;
    filter: drop-shadow(1.2cqi 1cqi 0 var(--c-ink));
  }
  /* The icon's ball is 18 of its 24 units; scale it so the seams run to the ink ring. */
  .ball :global(svg) {
    display: block;
    width: 133.4%;
    height: 133.4%;
    margin: -16.7%;
    stroke-width: 1.2;
  }
  .ball :global(path:nth-of-type(2)) {
    display: none;
  }

  /* ---------- back: a 1975 card back ----------
     Two spot inks (green, red) on grey-brown cardboard; where they overprint, the red
     reads as a softer salmon. Vitals and bio set in a Franklin Gothic stand-in, the name band
     and record in a condensed gothic, everything in caps the way Topps-era backs were. */
  .back {
    --b-board: #b8ab8f;
    --b-green: #2b6a46;
    --b-red: #c94f3f;
    --b-salmon: #d98a76;
    --b-ink: #1e3b2b; /* dark green: text printed over the red */

    background: var(--b-board);
    border: 7px solid var(--b-board);
    color: var(--b-ink);
    display: flex;
    flex-direction: column;
    font-family: 'Libre Franklin', var(--font);
  }
  .back a {
    color: inherit;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.25em;
  }
  .sheet {
    flex: 1;
    display: flex;
    flex-direction: column;
    border: 1.1cqi solid var(--b-green);
    border-radius: 1cqi 14cqi 1cqi 1cqi;
    overflow: hidden;
  }

  /* vitals: one red panel, label over value, like the vitals block on a '70s back */
  .top {
    display: grid;
    grid-template-columns: 1fr 1fr 1.3fr;
    gap: 2.4cqi 3cqi;
    background: var(--b-red);
    padding: 3.4cqi 3.8cqi;
    border-bottom: 1.1cqi solid var(--b-green);
  }
  .top .span2 {
    grid-column: span 2;
  }
  .top dt {
    font-size: 2.6cqi;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    opacity: 0.8;
  }
  .top dd {
    font-family: 'Barlow Condensed', var(--font);
    font-size: 6cqi;
    font-weight: 700;
    line-height: 1.05;
    text-transform: uppercase;
  }

  /* green band: card number in a cardboard box, name and position reversed out */
  .band {
    display: flex;
    align-items: center;
    gap: 5cqi;
    background: var(--b-green);
    padding: 1.8cqi 3.4cqi;
    font-family: 'Barlow Condensed', var(--font);
    text-transform: uppercase;
  }
  .num {
    background: var(--b-board);
    color: var(--b-green);
    font-weight: 700;
    font-size: 6.4cqi;
    line-height: 1;
    padding: 0.6cqi 1.6cqi 0.4cqi;
  }
  .nm {
    color: #ece2c6;
    font-weight: 500;
    font-size: 7cqi;
    letter-spacing: 0.04em;
    line-height: 1;
  }
  .dot {
    margin-inline: 2.4cqi;
  }

  /* record: green rules on bare cardboard, condensed caps */
  .record {
    padding: 1.6cqi 3.4cqi 2cqi;
    font-family: 'Barlow Condensed', var(--font);
    text-transform: uppercase;
  }
  .record h3 {
    font-family: 'Libre Franklin', var(--font);
    font-size: 3cqi;
    font-weight: 800;
    letter-spacing: 0.02em;
    text-align: center;
    color: var(--b-green);
    padding-bottom: 1cqi;
    border-bottom: 0.5cqi solid var(--b-green);
  }
  .record table {
    font-size: 3.7cqi;
  }
  .record th,
  .record td {
    border: 0;
    padding: 0.5cqi 2cqi 0.5cqi 0;
    font-size: inherit;
    font-weight: 500;
    letter-spacing: 0.02em;
    text-transform: inherit;
  }
  .record thead th {
    font-weight: 700;
    border-bottom: 0.4cqi solid var(--b-green);
  }
  .record tfoot td {
    font-weight: 700;
    border-top: 0.4cqi solid var(--b-green);
  }
  .yrs {
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }

  /* bio: red box ruled in green */
  .blurb {
    flex: 1;
    margin: 0 2.4cqi 2.4cqi;
    background: var(--b-red);
    border: 0.8cqi solid var(--b-green);
    padding: 3cqi 3.8cqi;
    font-size: 5cqi;
    font-weight: 500;
    line-height: 1.3;
  }
  .imprint {
    padding: 1.4cqi 2cqi 0;
    font-family: 'Libre Franklin', var(--font);
    font-size: 2.4cqi;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--b-green);
  }
</style>
