---
import type { Job } from '../lib/resume';

type Props = { label: string; jobs: Job[] };
const { label, jobs } = Astro.props;
---

<div class="box">
<table>
  <thead>
    <tr><th class="when">When</th><th>{label}</th><th>Title</th></tr>
  </thead>
  <tbody>
    {
      jobs.map((job) => (
        <tr>
          <td class="when">{job.when}</td>
          <td><b>{job.org}</b>, {job.place}</td>
          <td>{job.title}</td>
        </tr>
      ))
    }
  </tbody>
</table>
</div>

<style>
  .when {
    width: 170px;
    white-space: nowrap;
  }
  @media (max-width: 640px) {
    .when {
      width: auto;
      white-space: normal;
    }
  }
</style>
