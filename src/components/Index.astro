---
import { getPosts, postHref } from '../lib/posts';
import { formatIndexDate } from '../lib/format';
import { PAGES, type Current } from '../lib/nav';
import { AUTHOR, SITE_NAME } from '../lib/seo';
import chevron from '@tabler/icons/outline/chevron-down.svg?raw';

type Props = { current: Current };
const { current } = Astro.props;
const posts = await getPosts();
const isCurrentPost = (id: string) => current.kind === 'post' && current.id === id;
---

<nav class="index" aria-label="Site" data-index>
  <div class="box">
    <table>
      <tbody>
        <tr class="who">
          <td colspan="3">
            <div class="who-row">
              <a href="/">{SITE_NAME}<span>by {AUTHOR}</span></a>
              {/* Phones only: the post list and page links fold behind this. */}
              <button type="button" class="menu" aria-expanded="false" aria-controls="index-posts index-links">
                Index<span class="chev" set:html={chevron} />
              </button>
            </div>
          </td>
        </tr>
      </tbody>
      <tbody class="posts" id="index-posts">
        <tr><th>No.</th><th>Post</th><th class="num">Date</th></tr>
        {
          posts.map((post) => (
            <tr class:list={{ on: isCurrentPost(post.id) }}>
              <td>{String(post.data.no).padStart(2, '0')}</td>
              <td>
                <a href={postHref(post)} aria-current={isCurrentPost(post.id) ? 'page' : undefined}>
                  {post.data.shortTitle ?? post.data.title}
                </a>
              </td>
              <td class="num">{post.data.draft ? 'draft' : formatIndexDate(post.data.date)}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  <ul class="box links" id="index-links">
    {
      PAGES.map((page) => {
        const on = current.kind === 'page' && current.page === page.key;
        return (
          <li class:list={{ on }}>
            <a href={page.href} aria-current={on ? 'page' : undefined}>{page.label}</a>
          </li>
        );
      })
    }
  </ul>
</nav>

<script>
  for (const nav of document.querySelectorAll<HTMLElement>('[data-index]')) {
    const button = nav.querySelector('.menu');
    button?.addEventListener('click', () => {
      const open = button.getAttribute('aria-expanded') !== 'true';
      button.setAttribute('aria-expanded', String(open));
      nav.classList.toggle('open', open);
    });
  }
</script>

<style>
  .index {
    position: sticky;
    top: 24px;
    display: grid;
    gap: 12px;
  }
  .index a {
    display: block;
    text-decoration: none;
  }
  .who td {
    font-family: var(--font-display);
    font-weight: var(--strong-weight);
    font-size: var(--text-lead);
    line-height: 1.2;
    padding-block: 8px;
  }
  .who-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }
  .who span {
    display: block;
    font-family: var(--font);
    font-weight: 400;
    font-size: var(--text-meta);
    margin-top: 2px;
    color: var(--mute);
  }
  .menu {
    display: none;
    align-items: center;
    gap: 4px;
    min-height: 44px;
    padding: 0 4px 0 12px;
    margin-block: -6px;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    font-family: var(--font);
    font-size: var(--text-body);
    font-weight: 400;
    cursor: pointer;
  }
  .chev {
    display: flex;
  }
  .chev :global(svg) {
    width: 18px;
    height: 18px;
    stroke-width: 1.5;
    transition: rotate 0.2s ease-out;
  }
  .open .chev :global(svg) {
    rotate: 180deg;
  }
  @media (prefers-reduced-motion: reduce) {
    .chev :global(svg) {
      transition: none;
    }
  }
  tr.on td,
  li.on {
    background: var(--ink);
    color: var(--paper);
  }
  .posts tr:not(.on):hover td,
  .links li:not(.on):hover {
    background: var(--hover);
  }
  .links {
    list-style: none;
  }
  .links li + li {
    border-top: var(--rule);
  }
  .links a {
    padding: 5px 8px;
  }

  /* Touch screens: every nav row is a 44px target. */
  @media (pointer: coarse) {
    .links a {
      padding-block: 11px;
    }
    /* The link, not the cell, takes the height, so the whole row answers a tap. */
    .posts a {
      padding-block: 10px;
      margin-block: -5px;
    }
    .posts td {
      vertical-align: middle;
    }
  }

  @media (max-width: 860px) {
    .index {
      position: static;
      gap: 8px;
    }
    /* Phones keep the post list, the only way to a post; the date column goes. */
    .posts th:nth-child(3),
    .posts td:nth-child(3) {
      display: none;
    }
    /* One equal column per page link, however many there are. */
    .links {
      display: grid;
      grid-auto-flow: column;
      grid-auto-columns: 1fr;
    }
    .links li + li {
      border-top: 0;
      border-left: var(--rule);
    }
    .links a {
      text-align: center;
    }
  }

  /* Phones fold the index into the masthead. Without scripts the button can't work, so it all stays out. */
  @media (max-width: 860px) and (scripting: enabled) {
    .menu {
      display: flex;
    }
    .index:not(.open) .posts,
    .index:not(.open) .links {
      display: none;
    }
  }
</style>
