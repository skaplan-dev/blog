---
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import PostView from '../../components/PostView.astro';
import { getPosts, postHref, postTheme, type Post } from '../../lib/posts';
import { postImage, postLd } from '../../lib/seo';

export const getStaticPaths = (async () => {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}) satisfies GetStaticPaths;

type Props = { post: Post };
const { post } = Astro.props;
const image = postImage(post.id, post.data.title, post.data.image);
const jsonLd = postLd(Astro.site, {
  title: post.data.title,
  description: post.data.description,
  date: post.data.date,
  path: postHref(post),
  image: image.src,
});
---

<Base
  title={post.data.title}
  description={post.data.description}
  current={{ kind: 'post', id: post.id }}
  theme={postTheme(post)}
  type="article"
  image={image}
  jsonLd={jsonLd}
>
  <meta property="article:published_time" content={post.data.date.toISOString().slice(0, 10)} slot="head" />
  <PostView post={post} />
</Base>
