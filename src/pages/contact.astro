---
import Page from '../layouts/Page.astro';

const contact = {
  location: 'Greater Boston, MA',
  email: 'sethkaplan73@gmail.com',
  github: { label: 'github.com/skaplan-dev', href: 'https://github.com/skaplan-dev' },
  linkedin: { label: 'linkedin.com/in/sethkaplan73', href: 'https://www.linkedin.com/in/sethkaplan73' },
} as const;
---

<Page
  title="Contact"
  page="contact"
  note={contact.location}
  description="Get in touch with Seth Kaplan: email, GitHub and LinkedIn."
>
  <div class="box">
    <table>
      <tbody>
        <tr><th style="width:150px">Email</th><td><a href={`mailto:${contact.email}`}>{contact.email}</a></td></tr>
        <tr><th>GitHub</th><td><a href={contact.github.href}>{contact.github.label}</a></td></tr>
        <tr><th>LinkedIn</th><td><a href={contact.linkedin.href}>{contact.linkedin.label}</a></td></tr>
      </tbody>
    </table>
  </div>
</Page>
